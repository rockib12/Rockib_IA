# =========================================================
# ROCKIB AI — ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================

# --- CONFIG SERVER ---
APP_NAME="Rockib AI"
APP_ENV=development  # development, testing, production
DEBUG=true
PORT=8000
HOST=0.0.0.0
PUBLIC_API_URL=https://dion-beaverlike-preceptively.ngrok-free.dev
CONCIERGE_WIDGET_URL=https://rockib-quenum.netlify.app/rockib-concierge.js
CONCIERGE_SITES_PATH=data/concierge_sites.json

# --- DATABASE CONFIG (POSTGRESQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Required by Docker Compose. Generate a unique URL-safe value with:
# python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=rockib_ai

# SQLAlchemy URL synchrone & asynchrone
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/rockib_ai
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/rockib_ai

# --- SECURITY & JWT ---
# Générez une clé robuste avec: openssl rand -hex 32
JWT_SECRET_KEY=supersecretkeythatisatleast32characterslongforsecurity
CREDENTIAL_VAULT_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 heures

# --- WAWEB (VPS WHATSAPP BOT) ---
WHATSAPP_API_URL=http://your-vps-ip:3000
WHATSAPP_SESSION_ID=rockib_session
WHATSAPP_API_KEY=vps-api-key-for-whatsapp-web

# --- EMERGENCY CONTACT (TWILIO) ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
OWNER_PHONE_NUMBER=+33600000000  # Votre téléphone pour escalade et WhatsApp

# --- TELEGRAM BOT & ESCALADE INTERACTIVE ---
# Token obtenu via @BotFather sur Telegram (ex: 7123456789:AAHk..._votre_token)
TELEGRAM_BOT_TOKEN=
# Votre Chat ID personnel obtenu via @userinfobot sur Telegram (ex: 123456789)
TELEGRAM_ADMIN_CHAT_ID=

# --- AI & COGNITIVE / INTELLIGENCE MODELS ---
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_MODEL_NAME=openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
ANALYTICAL_MODEL_NAME=deepseek-coder
